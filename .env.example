# Names only. Copy to .env (git-ignored) and fill in locally. Never commit values.

# Plaid (sandbox). Also stored as OutLayer secrets, profile "kredofi".
PLAID_CLIENT_ID=
PLAID_SECRET=

# Scorer sealing key: 32 random bytes, hex. OutLayer secret.
SEAL_KEY=
# Testnet/Dev only: the web server and demo scorer. Never the same as SEAL_KEY (mainnet OutLayer).
SEAL_KEY_TESTNET=

# NEAR AI Cloud (optional AI summary). OutLayer secret.
NEARAI_KEY=

# Demo recovery partner (x25519, hex). Public key goes into the contract config.
PARTNER_PRIVKEY=
PARTNER_PUBKEY=

# NEAR network and accounts
NEAR_NETWORK=
KREDOFI_CONTRACT_ID=
USDC_CONTRACT_ID=
DEV_SCORER_ACCOUNT_ID=
DEV_SCORER_KEY=

# No-wallet demo relayer (testnet only, web API route)
RELAYER_ACCOUNT_ID=
RELAYER_KEY=

# Web server (web/.env.local): testnet API routes run the demo scorer and the faucet
SCORER_WASM=
SCORER_OUT_DIR=
